# =============================================================================
# AI Phone Receptionist — Environment Variables
# Copy this file to .env (root, for local tooling) and to apps/web/.env.local
# and apps/voice-service/.env for each service. NEVER commit real values.
# =============================================================================

# --- OpenAI (Realtime voice model) ------------------------------------------
# Server-side only. Never expose to any browser bundle.
OPENAI_API_KEY=
# Realtime speech-to-speech model, e.g. gpt-realtime
OPENAI_MODEL=gpt-realtime

# --- Telephony provider (Twilio) --------------------------------------------
# TELEPHONY_ACCOUNT_ID  = Twilio Account SID (starts with AC...)
# TELEPHONY_AUTH_TOKEN  = Twilio Auth Token (used to sign & verify webhooks)
# TELEPHONY_PHONE_NUMBER = The shop's Twilio number in E.164 format, e.g. +14155551234
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=

# Number the AI transfers callers to when a human is needed (E.164 format)
HUMAN_TRANSFER_NUMBER=

# --- Supabase / PostgreSQL ---------------------------------------------------
# Server-side service role key — full DB access, bypasses Row Level Security.
# NEVER expose this to any client-side / browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public, browser-safe values for the admin dashboard (apps/web).
# The anon key is safe to expose; RLS policies restrict what it can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Public base URL of the voice service (used to build Twilio webhook /
# Media Stream URLs, e.g. https://voice.yourshop.com or an ngrok/tunnel URL
# during local development) -----------------------------------------------
PUBLIC_BASE_URL=

# --- Internal webhook/service secret -----------------------------------------
# Shared secret used to authenticate server-to-server calls between apps/web
# (admin config API) and apps/voice-service (e.g. config refresh, health
# introspection). Generate with: openssl rand -hex 32
VOICE_WEBHOOK_SECRET=

# --- Voice service runtime ---------------------------------------------------
PORT=8080
NODE_ENV=development

# --- Data retention / compliance --------------------------------------------
# Number of days call metadata is retained before purge (see docs/SECURITY.md)
CALL_RECORD_RETENTION_DAYS=90
# Whether call audio transcripts may be persisted at all (default: false).
# Only enable after confirming legal requirements (consent/disclosure) for
# your jurisdiction — see docs/SECURITY.md.
ENABLE_TRANSCRIPT_STORAGE=false
